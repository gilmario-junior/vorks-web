{
  "name": "vorks-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run services:up && next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run ",
    "test:watch": "vitest --watch --reporter=verbose",
    "seed:dev": "tsx src/tests/seed.ts",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "migrations:create": "node-pg-migrate create",
    "migrations:up": "node-pg-migrate --envPath .env.development up"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "next": "16.2.6",
    "next-connect": "^1.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/async-retry": "^1.4.9",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "async-retry": "^1.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "import": "^0.0.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10"
  }
}
